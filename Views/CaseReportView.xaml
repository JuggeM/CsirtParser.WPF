<UserControl x:Class="CsirtParser.WPF.Views.CaseReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MultiLine" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="4,6"/>
        </Style>
    </UserControl.Resources>

    <!-- The panel inherits MainViewModel; bind to its Report from inside the view
         (a DataContext binding on the view itself in MainWindow's style never resolves) -->
    <StackPanel DataContext="{Binding Report}">
        <TextBlock Text="Case report" Style="{StaticResource SectionTitle}"/>

        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10">
            A readable case summary in English for stakeholders, built from the processed output. Every finding
            names its host and source and carries an estimated likelihood (almost certain, highly likely, likely…).
            Review the automatic values, edit the text, then export. Edits are saved with the case and kept when you
            re-run the parser.
        </TextBlock>

        <!-- Actions -->
        <WrapPanel>
            <Button Content="Open in browser" Style="{StaticResource PrimaryButton}"
                    Command="{Binding OpenCommand}" Padding="14,6" Margin="0,0,8,8"
                    ToolTip="Writes CaseReport.html to the output folder and opens it. Print from the browser to get a PDF."/>
            <Button x:Name="ExportButton" Content="Export ▾" Style="{StaticResource StandardButton}"
                    Click="ExportButton_Click" Padding="14,6" Margin="0,0,8,8"
                    IsEnabled="{Binding HasData}"
                    ToolTip="Save the report as HTML, RTF or Word">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="HTML (.html) — self-contained page, print to PDF"
                                  Command="{Binding ExportCommand}" CommandParameter="html"/>
                        <MenuItem Header="Word (.docx)"
                                  Command="{Binding ExportCommand}" CommandParameter="docx"/>
                        <MenuItem Header="Rich Text (.rtf) — Word, WordPad, LibreOffice"
                                  Command="{Binding ExportCommand}" CommandParameter="rtf"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Content="Rebuild from output" Style="{StaticResource StandardButton}"
                    Command="{Binding RefreshCommand}" Padding="14,6" Margin="0,0,8,8"
                    ToolTip="Reads Findings.tsv and IocHits.tsv again. Your edits are kept."/>
            <Button Content="Save edits" Style="{StaticResource StandardButton}"
                    Command="{Binding SaveCommand}" Padding="14,6" Margin="0,0,8,8"
                    ToolTip="Saves to CaseReport.json in the output folder (also done on export and when you leave this panel)"/>
        </WrapPanel>
        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12" Margin="0,0,0,14"/>

        <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVisibilityConverter}}">

            <!-- Header -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Severity" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding SeverityLevels}" SelectedItem="{Binding Severity}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding StatusLevels}" SelectedItem="{Binding Status}"/>
                </StackPanel>
            </Grid>

            <!-- Bottom line -->
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Redraft from findings" Style="{StaticResource StandardButton}"
                        Command="{Binding DraftBlufCommand}" Height="26" Padding="10,0"
                        ToolTip="Replaces the text below with a new draft based on the findings included in the report"/>
                <TextBlock Text="Bottom line up front (2–4 sentences, use likelihood terms)" Style="{StaticResource FieldLabel}"
                           VerticalAlignment="Bottom"/>
            </DockPanel>
            <TextBox Style="{StaticResource MultiLine}" MinHeight="96" MaxHeight="180"
                     Text="{Binding Bluf, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

            <!-- Findings -->
            <TextBlock Text="Key findings" FontWeight="Medium" FontSize="13"/>
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,6">
                Tick what goes in the report and adjust the likelihood if you know more. Select a row to see why the
                value was chosen and to add a note. Scale: almost certain ≥95% · highly likely 80–90% · likely 55–75% ·
                realistic possibility 40–50% · unlikely 25–35%.
            </TextBlock>
            <DockPanel Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding SelectHighText}" Style="{StaticResource StandardButton}"
                            Command="{Binding SelectHighCommand}" Height="26" Padding="10,0" Margin="6,0,0,0"
                            ToolTip="Ticks every CRITICAL and HIGH finding and unticks the rest"/>
                    <Button Content="{Binding SelectAllText}" Style="{StaticResource StandardButton}"
                            Command="{Binding SelectAllCommand}" Height="26" Padding="10,0" Margin="6,0,0,0"
                            ToolTip="Ticks every finding in the list"/>
                    <Button Content="{Binding ResetSelectionText}" Style="{StaticResource StandardButton}"
                            Command="{Binding ResetSelectionCommand}" Height="26" Padding="10,0" Margin="6,0,0,0"
                            ToolTip="Back to the default: every CRITICAL, the strongest 4 HIGH per host and lateral movement. Likelihoods and notes are kept."/>
                </StackPanel>
                <TextBlock Text="{Binding Summary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>

            <DataGrid ItemsSource="{Binding Findings}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" HeadersVisibility="Column"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                      Background="White" RowBackground="White"
                      RowDetailsVisibilityMode="VisibleWhenSelected"
                      MaxHeight="460" FontSize="12"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      Margin="0,0,0,16">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="Padding" Value="6,5"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="In" Width="34">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="8,6,0,0" VerticalAlignment="Top"
                                          ToolTip="Include in the report"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Likelihood" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.LikelihoodOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Likelihood, UpdateSourceTrigger=PropertyChanged}"
                                          Height="26" FontSize="12" Margin="2,3" VerticalAlignment="Top"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Host" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Host}" Style="{StaticResource CellText}" FontFamily="Consolas"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Time (UTC)" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource CellText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Source" Width="78">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource CellText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Finding" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource CellText}" ToolTip="{Binding Text}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}" Padding="12,8" Margin="34,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock FontSize="12" Margin="0,0,0,6">
                                    <Run Text="Basis: " Foreground="{StaticResource TextSecondaryBrush}"/><Run Text="{Binding Basis, Mode=OneWay}"/>
                                </TextBlock>
                                <DockPanel>
                                    <TextBlock Text="Note" DockPanel.Dock="Left" Width="40" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="12"
                                             ToolTip="Shown under the finding in the report, e.g. why you changed the likelihood"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>

            <!-- Gaps -->
            <TextBlock Text="Intelligence gaps (one per line)" Style="{StaticResource FieldLabel}"/>
            <TextBox Style="{StaticResource MultiLine}" MinHeight="70" MaxHeight="160"
                     Text="{Binding Gaps, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding AutoGaps}" FontSize="12" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,16"
                       ToolTip="Detected from the data and always added to the report">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Next steps -->
            <TextBlock Text="Next steps (one per line, start with [x] when done)" Style="{StaticResource FieldLabel}"/>
            <TextBox Style="{StaticResource MultiLine}" MinHeight="90" MaxHeight="180"
                     Text="{Binding NextSteps, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
        </StackPanel>
    </StackPanel>
</UserControl>
